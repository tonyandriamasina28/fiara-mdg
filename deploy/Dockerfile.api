# API fiara.mdg — Express 5 / TypeScript exécuté par tsx
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
RUN npm ci --workspace apps/api --include=dev && npm cache clean --force

COPY db ./db
COPY apps/api ./apps/api

# Dossiers persistants : photos (publiques) et pièces d'identité chiffrées (privées, jamais servies)
RUN mkdir -p apps/api/uploads apps/api/private/identity && chown -R node:node apps/api/uploads apps/api/private
USER node
EXPOSE 4000
CMD ["npm", "run", "start", "--workspace", "apps/api"]
