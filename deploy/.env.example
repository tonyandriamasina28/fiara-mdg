# Domaine public (DNS A/AAAA vers l'IP du VPS IONOS)
DOMAIN=fiara.mg
NODE_ENV=production

# Secrets — générer chacun avec : openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Clé AES-256 des pièces d'identité. À sauvegarder HORS du serveur (gestionnaire de mots de passe) :
# sans elle, les documents chiffrés sont définitivement illisibles.
IDENTITY_ENCRYPTION_KEY=

# Paiements (vides = paiements carte / PayPal désactivés en production)
MGA_PER_EUR=5200
CARD_CURRENCY=EUR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com

# Sauvegardes chiffrées vers IONOS Object Storage (compatible S3) — voir deploy/backup.sh
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
BACKUP_S3_BUCKET=fiara-sauvegardes
BACKUP_PASSPHRASE=
